# Prod — copiez vers .env.prod (jamais commité, valeurs via secrets CI en réel)
# Usage: docker compose --env-file .env.prod -f docker-compose.yml up --build -d
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me-prod-use-vault-or-gh-secrets
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://medlink.example.com

# Keycloak — mode production (HTTPS terminé au reverse-proxy)
KEYCLOAK_START_MODE=start
KEYCLOAK_PUBLIC_URL=https://auth.medlink.example.com
APP_PUBLIC_URL=https://api.medlink.example.com
KEYCLOAK_DB_PASSWORD=change-me-prod-use-gh-secrets
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-prod-use-gh-secrets
KC_BFF_CLIENT_SECRET=change-me-prod-use-gh-secrets
# Comptes de test importés avec le realm : à supprimer dans Keycloak après le premier démarrage
KC_DEV_USERS_PASSWORD=change-me-prod-use-gh-secrets
