FROM maven:3.9-eclipse-temurin-26
RUN groupadd --system app && useradd --system --gid app --create-home app
WORKDIR /app
RUN chown app:app /app
USER app
COPY --chown=app:app pom.xml .
COPY --chown=app:app .mvn .mvn
COPY --chown=app:app mvnw mvnw.cmd ./
RUN ./mvnw -B -DskipTests dependency:go-offline || true
COPY --chown=app:app src src
EXPOSE 8080 5005
ENV SPRING_PROFILES_ACTIVE=dev
ENV MAVEN_OPTS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
CMD ["./mvnw", "spring-boot:run"]
