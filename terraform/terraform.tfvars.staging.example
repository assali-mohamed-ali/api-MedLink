# Staging — terraform plan -var-file="terraform.tfvars.staging" (ne jamais committer le vrai fichier)
# Les secrets peuvent aussi venir de TF_VAR_* (recommandé en CI, jamais dans la ligne de commande).
app_image                    = "ghcr.io/assali-mohamed-ali/api-medlink@sha256:change-me-staging"
app_container_name           = "api-medlink-staging"
app_external_port            = 8081
network_name                 = "medlink-staging"
db_url                       = "jdbc:postgresql://postgres-staging:5432/mydatabase"
db_username                  = "myuser"
db_password                  = "change-me-staging"
keycloak_public_url          = "https://auth.staging.medlink.example.com"
keycloak_internal_url        = "http://keycloak:8080"
keycloak_realm               = "medlink"
keycloak_client_id           = "medlink-bff"
keycloak_client_secret       = "change-me-staging"
keycloak_admin_client_id     = "medlink-admin"
keycloak_admin_client_secret = "change-me-staging"
mail_host                    = "smtp.example.com"
mail_port                    = 587
mail_username                = "change-me-staging"
mail_password                = "change-me-staging"
mail_from                    = "MedLink <no-reply@staging.medlink.example.com>"
app_frontend_url             = "https://staging.medlink.example.com"
cors_allowed_origins         = "https://staging.medlink.example.com"
