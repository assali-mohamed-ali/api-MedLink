# terraform plan -var-file="terraform.tfvars" — ne jamais committer le vrai fichier
# Les secrets peuvent aussi venir de TF_VAR_* (recommandé en CI, jamais dans la ligne de commande).
app_image                  = "ghcr.io/assali-mohamed-ali/api-medlink@sha256:change-me"
app_container_name         = "api-medlink"
app_external_port          = 8080
network_name               = "medlink"
db_url                     = "jdbc:postgresql://postgres:5432/mydatabase"
db_username                = "myuser"
db_password                = "change-me"
keycloak_public_url        = "https://auth.example.com"
keycloak_internal_url      = "http://keycloak:8080"
keycloak_realm             = "medlink"
keycloak_client_id         = "medlink-bff"
keycloak_client_secret     = "change-me"
keycloak_admin_client_id   = "medlink-admin"
keycloak_admin_client_secret = "change-me"
mfa_encryption_key         = "change-me"
documents_storage_endpoint = "https://minio.example.com"
documents_storage_access_key = "change-me-documents-access-key"
documents_storage_secret_key = "change-me-documents-secret-key"
documents_storage_bucket   = "medlink-documents"
documents_storage_create_bucket = false
documents_encryption_key   = "change-me-documents-encryption-key"
mail_host                  = "smtp.example.com"
mail_port                  = 587
mail_username              = "change-me"
mail_password              = "change-me"
mail_from                  = "MedLink <no-reply@medlink.example.com>"
app_frontend_url           = "https://medlink.example.com"
cors_allowed_origins       = "https://medlink.example.com"
