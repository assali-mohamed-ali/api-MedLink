{
  "realm": "medlink",
  "displayName": "MedLink",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "waitIncrementSeconds": 900,
  "maxFailureWaitSeconds": 900,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": [
    "LOGIN", "LOGIN_ERROR", "LOGOUT", "USER_DISABLED_BY_TEMPORARY_LOCKOUT",
    "UPDATE_PASSWORD", "UPDATE_TOTP", "VERIFY_EMAIL"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "ADMINISTRATIVE_STAFF",
        "description": "MedLink administrative staff: manages users and their roles in this realm",
        "composite": true,
        "composites": {
          "client": {
            "realm-management": ["view-users", "manage-users", "query-users", "query-groups", "view-realm"]
          }
        }
      },
      {
        "name": "PRACTITIONER",
        "description": "Practitioner"
      },
      {
        "name": "PATIENT",
        "description": "Patient"
      }
    ]
  },
  "groups": [
    { "name": "administrative-staff", "path": "/administrative-staff", "realmRoles": ["ADMINISTRATIVE_STAFF"] },
    { "name": "practitioners", "path": "/practitioners", "realmRoles": ["PRACTITIONER"] },
    { "name": "patients", "path": "/patients", "realmRoles": ["PATIENT"] }
  ],
  "defaultGroups": ["/patients"],
  "clients": [
    {
      "clientId": "medlink-bff",
      "name": "MedLink BFF",
      "description": "Spring Boot backend (auth BFF). Confidential client: only the password grant, called server to server by the API's login endpoint. No redirect login.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${KC_BFF_BASE_URL}",
      "baseUrl": "/",
      "redirectUris": ["${KC_BFF_BASE_URL}/login/oauth2/code/keycloak"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${KC_BFF_BASE_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "medlink-admin",
      "name": "MedLink admin calls",
      "description": "Service account the API uses for Keycloak admin calls (create users, passwords, email verified). No login flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-medlink-admin",
      "enabled": true,
      "serviceAccountClientId": "medlink-admin",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "query-groups"]
      }
    },
    {
      "username": "staff.dev",
      "email": "staff.dev@medlink.local",
      "firstName": "Staff",
      "lastName": "Dev",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/administrative-staff"],
      "credentials": [{ "type": "password", "value": "${KC_DEV_USERS_PASSWORD}", "temporary": false }]
    },
    {
      "username": "practitioner.dev",
      "email": "practitioner.dev@medlink.local",
      "firstName": "Practitioner",
      "lastName": "Dev",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/practitioners"],
      "credentials": [{ "type": "password", "value": "${KC_DEV_USERS_PASSWORD}", "temporary": false }]
    },
    {
      "username": "patient.dev",
      "email": "patient.dev@medlink.local",
      "firstName": "Patient",
      "lastName": "Dev",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/patients"],
      "credentials": [{ "type": "password", "value": "${KC_DEV_USERS_PASSWORD}", "temporary": false }]
    }
  ]
}
