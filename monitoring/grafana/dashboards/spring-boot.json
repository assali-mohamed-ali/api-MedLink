{
  "title": "MedLink API and hosts",
  "uid": "api-medlink",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "API availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "medlink-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"api-medlink-.+\"}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Request rate by environment",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "medlink-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP 5xx rate (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "medlink-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (job) (rate(http_server_requests_seconds_count[5m]))"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP p95 latency (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "medlink-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "title": "Host availability",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "medlink-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"node\"}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Host filesystem used (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "medlink-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",fstype=~\"ext[234]|xfs|btrfs\"} / node_filesystem_size_bytes{job=\"node\",fstype=~\"ext[234]|xfs|btrfs\"})"
        }
      ]
    }
  ]
}
