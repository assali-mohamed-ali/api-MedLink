# Copiez vers .env (jamais commité) pour docker-compose local
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me-in-local-env
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Keycloak (keycloak/realm-medlink.json)
KEYCLOAK_START_MODE=start-dev
KEYCLOAK_PUBLIC_URL=http://localhost:8180
APP_PUBLIC_URL=http://localhost:8080
KEYCLOAK_DB_PASSWORD=change-me-in-local-env
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-local-env
KC_BFF_CLIENT_SECRET=change-me-openssl-rand-hex-32
# Mot de passe des comptes de test admin.dev / doctor.dev / patient.dev
KC_DEV_USERS_PASSWORD=change-me-Dev-2026!
