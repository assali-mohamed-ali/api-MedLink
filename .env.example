# Copiez vers .env (jamais commité). Lu par docker-compose.yml (full stack) seulement:
# compose.yaml (dev, mvnw spring-boot:run) a ses valeurs dev fixes et n'en utilise aucune.
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me-in-local-env
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200
# React app: the links in our mails open its pages
APP_FRONTEND_URL=http://localhost:3000
# Mail: Mailpit in dev (inbox http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=MedLink <no-reply@medlink.local>

# Keycloak (keycloak/realm-medlink.json)
KEYCLOAK_START_MODE=start-dev
KEYCLOAK_PUBLIC_URL=http://localhost:8180
APP_PUBLIC_URL=http://localhost:8080
KEYCLOAK_DB_PASSWORD=change-me-in-local-env
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-local-env
KC_BFF_CLIENT_SECRET=change-me-openssl-rand-hex-32
# Service account medlink-admin: the API's Keycloak admin calls
KC_ADMIN_CLIENT_SECRET=change-me-openssl-rand-hex-32
# Mot de passe des comptes de test staff.dev / practitioner.dev / patient.dev
KC_DEV_USERS_PASSWORD=change-me-Dev-2026!
