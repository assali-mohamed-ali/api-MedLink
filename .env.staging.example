# Staging — copiez vers .env.staging (jamais commité)
# Usage: docker compose --env-file .env.staging -f docker-compose.yml up --build
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me-staging
SPRING_PROFILES_ACTIVE=staging
CORS_ALLOWED_ORIGINS=https://staging.medlink.example.com

# Keycloak — mode production (HTTPS terminé au reverse-proxy)
KEYCLOAK_START_MODE=start
KEYCLOAK_PUBLIC_URL=https://auth.staging.medlink.example.com
APP_PUBLIC_URL=https://api.staging.medlink.example.com
KEYCLOAK_DB_PASSWORD=change-me-staging-use-gh-secrets
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-staging-use-gh-secrets
KC_BFF_CLIENT_SECRET=change-me-staging-use-gh-secrets
# Service account medlink-admin: the API's Keycloak admin calls
KC_ADMIN_CLIENT_SECRET=change-me-staging-use-gh-secrets
# Comptes de test importés avec le realm : à supprimer dans Keycloak après le premier démarrage
KC_DEV_USERS_PASSWORD=change-me-staging-use-gh-secrets
